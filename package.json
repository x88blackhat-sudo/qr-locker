{
  "name": "bactrack-dz",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "BacTrack DZ — premium Arabic-first Baccalaureate study platform with a server-enforced 30-day free trial.",
  "scripts": {
    "dev": "concurrently -k -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "NODE_ENV=development tsx watch server/src/index.ts",
    "dev:client": "vite --host 0.0.0.0",
    "build": "npm run typecheck && vite build",
    "start": "NODE_ENV=production tsx server/src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit",
    "db:seed": "tsx server/src/db/seed-cli.ts",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/alexandria": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@tanstack/react-query": "^5.104.4",
    "clsx": "^2.1.1",
    "express": "^5.3.0",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
