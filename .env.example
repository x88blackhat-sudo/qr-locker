# ── BacTrack DZ — environment ────────────────────────────────────────────────
# Copy to `.env` and adjust. Sensible defaults exist for local development.

# HTTP port for the API + built client (bound to HOST).
PORT=3000
HOST=0.0.0.0

# Absolute path for the SQLite database file. Defaults to ./data/bactrack.db
# DATABASE_PATH=/var/lib/bactrack/bactrack.db

# Required in production: the only external origin allowed to call the API.
# Same-origin requests are always accepted (Origin host === Host header).
# APP_ORIGIN=https://bactrack.example.com

# `secure` cookie flag. Enable when served over HTTPS (recommended in prod).
# COOKIE_SECURE=true

# Session lifetime (days).
SESSION_DAYS=30

# Set to "true" only when the server is behind a trusted reverse proxy.
TRUST_PROXY=true

# Optional support address shown on the plans page.
# SUPPORT_EMAIL=support@bactrack.dz

# ── Payments (NOT configured by default) ─────────────────────────────────────
# BacTrack DZ ships WITHOUT a payment provider. The trial is fully functional,
# but `active_paid` can only be set by a verified server-side payment webhook.
# See README → "Adding real payments" before enabling anything below.
# PAYMENT_PROVIDER=
# PAYMENT_WEBHOOK_SECRET=
